# Football Oracle - API Configuration

# API-Football.com (via RapidAPI)
# Sign up at: https://rapidapi.com/api-sports/api/api-football
# Free tier: 100 requests/day
API_FOOTBALL_KEY=your_rapidapi_key_here

# TheSportsDB
# Sign up at: https://www.thesportsdb.com/api.php
# Free tier: 3 requests/minute, Public key "3" for testing
THESPORTSDB_KEY=3

# Football-Data.org
# Sign up at: https://www.football-data.org/client/register
# Free tier: 10 requests/minute
FOOTBALL_DATA_KEY=your_football_data_key_here

# Admin Principal (deployer becomes admin by default)
# You can override this after deployment
ADMIN_PRINCIPAL=
